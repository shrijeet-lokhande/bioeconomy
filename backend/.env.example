# Bioeconomy backend configuration (PLACEHOLDERS ONLY — copy to .env and fill in).
# backend/.env is gitignored; never commit real credentials or API keys.

# --- Database ---
# SQLAlchemy URL (psycopg 3 dialect).
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/bioeconomy

# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cookie flags: COOKIE_SECURE must be 1 whenever served over HTTPS.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Server-side absolute session lifetime.
SESSION_LIFETIME_HOURS=168

# Process-local rate limiting for register/login/verify/resend (single
# instance only).
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=5

# --- Email verification ---
# Trusted base URL used inside verification links (never derived from a
# request Host header).
APP_BASE_URL=http://localhost:5173

# Verification token lifetime, in minutes.
VERIFICATION_TOKEN_MINUTES=30
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_EMAIL_LIMIT_PER_HOUR=3

# Delivery backend: console | smtp | resend.
#   console — development only: verification emails are written as clearly
#             labeled .eml files into the gitignored ./mail_outbox directory.
#   smtp    — generic SMTP relay (see MAIL_* below). Example: Mailgun/postfix.
#   resend  — Resend HTTP API (see RESEND_API_KEY below).
MAIL_BACKEND=console

# Where the console backend writes .eml files (relative to backend/).
MAIL_OUTBOX_DIR=.mail_outbox

# Generic SMTP settings (MAIL_BACKEND=smtp). MAIL_USE_TLS=1 enforces
# STARTTLS. Example placeholder values — use real relays only in real .env.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp-username
MAIL_PASSWORD=smtp-password
MAIL_USE_TLS=1

# Address verification emails are sent FROM. Resend test accounts (without
# a verified domain) require: onboarding@resend.dev
MAIL_FROM_ADDRESS=verified-sender@your-domain.example

# Resend HTTP API key (MAIL_BACKEND=resend). Secret: .env only, never commit.
RESEND_API_KEY=re_placeholder_replace_with_real_key

# --- Biomass record images (1–5 compulsory uploads per lot/listing) ---
# Directory for uploaded image files (absolute, or relative to backend/).
# Gitignored; files keep server-generated names and are served exclusively
# through the authorized /biomass/images/{id} endpoint — never as static
# files.
BIOMASS_IMAGE_UPLOAD_DIR=.data/biomass_images

# Per-file upload cap in MB. At most 5 images per record (server rules).
BIOMASS_IMAGE_MAX_MB=5
