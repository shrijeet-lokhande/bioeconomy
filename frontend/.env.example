# OpenFreeMap Liberty is the default, keyless public basemap. MapLibre shows
# source attribution automatically; keep this text for the page's provenance.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors

# Optional public map styles. Use a provider-compatible MapLibre style URL.
# MapTiler URLs commonly include a browser-visible public API token. Restrict
# that token to this app's origins and required map APIs; never put secrets in
# VITE_ variables. Blank means the selector reports the style unavailable.
VITE_MAP_TERRAIN_STYLE_URL=
VITE_MAP_TERRAIN_ATTRIBUTION=
VITE_MAP_SATELLITE_STYLE_URL=
VITE_MAP_SATELLITE_ATTRIBUTION=
