{
  "name": "bioeconomy-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/run-backend-dev.ps1\" \"vite\"",
    "dev:tunnel": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-dev-tunnel.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
